+    public static async Task InvokeAsync<TEvents>(this IEnumerable<TEvents> events, Func<TEvents, ValueTask> dispatch, ILogger logger)
+    {
+        foreach (var sink in events)
+        {
+            try
+            {
+                await dispatch(sink);

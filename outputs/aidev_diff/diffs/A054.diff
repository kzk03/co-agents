+            <TooltipContent side="right">
+              <div className="text-xs">
+                <div className="font-medium">{user.name}</div>
+                <div className="text-muted-foreground">{user.email}</div>
+              </div>
+            </TooltipContent>
+          </Tooltip>
+        ) : (
+          <Tooltip>
